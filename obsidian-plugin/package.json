    "test": "vitest run"
  },
  "dependencies": {
    "@obsidian-ai-providers/sdk": "1.9.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "happy-dom": "20.14.5",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.8.1"
  }
}
