      "items": [
        [
          "What precondition does binary search need?",
          "The array must be sorted."
        ],
        [
          "What is the loop invariant of binary search?",
          "If the target exists, it lies inside [lo, hi]."
        ],
        [
          "How many comparisons does binary search need?",
          "O(log n), because each step halves the interval."
        ],
        [
          "Inside a sub-heading",
          "still part of the review section"
        ]
      ]
    },
